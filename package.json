{
  "name": "smarfit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm build:web && node scripts/configure.mjs --local && wrangler d1 migrations apply DB --local --cwd worker --config wrangler.generated.json && wrangler dev --local --cwd worker --config wrangler.generated.json",
    "build:web": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "check:web": "vue-tsc --noEmit",
    "format": "prettier --write web scripts vite.config.ts",
    "format:check": "prettier --check web scripts vite.config.ts"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.5",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vue-tsc": "3.2.6",
    "wrangler": "4.162.0"
  }
}
